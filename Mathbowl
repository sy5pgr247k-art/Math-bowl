<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MathBowl | Minimalist Tech</title>
    <style>
        :root {
            --neon-blue: #00d2ff;
            --neon-purple: #9d50bb;
            --dark-bg: #0f0f12;
            --glass: rgba(255, 255, 255, 0.05);
        }

        body {
            background-color: var(--dark-bg);
            color: white;
            font-family: 'Inter', sans-serif;
            margin: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            min-height: 100vh;
            overflow-x: hidden;
        }

        /* --- Logo & Header --- */
        header {
            padding: 30px;
            text-align: center;
        }

        .logo {
            font-size: 2.5rem;
            font-weight: 800;
            letter-spacing: 4px;
            text-transform: uppercase;
            background: linear-gradient(to right, var(--neon-blue), var(--neon-purple));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            text-shadow: 0 0 20px rgba(0, 210, 255, 0.3);
        }

        /* --- The Lobby --- */
        .lobby {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 20px;
            margin-top: 50px;
        }

        .level-card {
            background: var(--glass);
            border: 1px solid rgba(255, 255, 255, 0.1);
            padding: 20px 50px;
            border-radius: 15px;
            cursor: pointer;
            transition: 0.3s;
            width: 250px;
            text-align: center;
            font-weight: bold;
            text-transform: uppercase;
        }

        .level-card:hover {
            border-color: var(--neon-blue);
            box-shadow: 0 0 15px var(--neon-blue);
            transform: translateY(-5px);
        }

        /* --- The Arena (Game Area) --- */
        .arena {
            display: none; /* Hidden until level is picked */
            margin-top: 50px;
            padding: 40px;
            border-radius: 25px;
            background: var(--glass);
            border: 2px solid var(--neon-purple);
            box-shadow: 0 0 30px rgba(157, 80, 187, 0.2);
            text-align: center;
            width: 350px;
            position: relative;
        }

        #question {
            font-size: 4rem;
            margin-bottom: 20px;
            font-family: monospace;
        }

        input {
            background: transparent;
            border: none;
            border-bottom: 2px solid var(--neon-blue);
            color: white;
            font-size: 2rem;
            text-align: center;
            width: 150px;
            outline: none;
            margin-bottom: 20px;
        }

        /* Decor: Pulsing LED accent */
        .led-border {
            position: absolute;
            top: -2px; left: -2px; right: -2px; bottom: -2px;
            border-radius: 25px;
            border: 2px solid var(--neon-blue);
            z-index: -1;
            animation: pulse 2s infinite;
        }

        @keyframes pulse {
            0% { opacity: 0.3; }
            50% { opacity: 1; }
            100% { opacity: 0.3; }
        }

        .hidden { display: none; }
    </style>
</head>
<body>

<header>
    <div class="logo">MathBowl</div>
</header>

<div id="lobby" class="lobby">
    <div class="level-card" onclick="startGame('rookie')">Rookie (1-10)</div>
    <div class="level-card" onclick="startGame('pro')">Pro (1-50)</div>
    <div class="level-card" onclick="startGame('all-star')">All-Star (1-100)</div>
</div>

<div id="arena" class="arena">
    <div class="led-border"></div>
    <div id="score">SCORE: 0</div>
    <div id="question">--</div>
    <input type="number" id="answer" autofocus>
</div>

<script>
    let currentScore = 0;
    let correctAnswer = 0;
    let currentLevel = '';

    function startGame(level) {
        currentLevel = level;
        document.getElementById('lobby').classList.add('hidden');
        document.getElementById('arena').style.display = 'block';
        nextQuestion();
    }

    function nextQuestion() {
        let max = currentLevel === 'rookie' ? 10 : currentLevel === 'pro' ? 50 : 100;
        let n1 = Math.floor(Math.random() * max) + 1;
        let n2 = Math.floor(Math.random() * max) + 1;
        
        correctAnswer = n1 + n2;
        document.getElementById('question').innerText = `${n1}+${n2}`;
        document.getElementById('answer').value = '';
        document.getElementById('answer').focus();
    }

    document.getElementById('answer').addEventListener('keypress', (e) => {
        if (e.key === 'Enter') {
            if (parseInt(e.target.value) === correctAnswer) {
                currentScore++;
                document.getElementById('score').innerText = `SCORE: ${currentScore}`;
                nextQuestion();
            } else {
                e.target.value = ''; // Flash red or shake could go here
            }
        }
    });
</script>

</body>
</html>
